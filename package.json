{
  "name": "saucepenny-monorepo",
  "private": true,
  "version": "0.3.0",
  "description": "Saucepenny (菜本易): free, offline, open-source recipe costing and menu pricing. Exact arithmetic; every number re-checked by an independent checker.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://kinfxhk.github.io/saucepenny/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kinfxhk/saucepenny.git"
  },
  "bugs": {
    "url": "https://github.com/Kinfxhk/saucepenny/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @saucepenny/web",
    "build": "npm run build -w @saucepenny/web",
    "start": "npm run build && npm run serve",
    "serve": "node --import tsx packages/cli/src/serve.ts",
    "saucepenny": "node --import tsx packages/cli/src/main.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "oracle": "python3 tools/oracle/oracle.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "screenshot": "node scripts/screenshot.mjs",
    "package:site": "node scripts/package-site.mjs",
    "fetch:gitleaks": "node scripts/fetch-verified.mjs gitleaks",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:secrets": "node scripts/secret-scan.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run check:licenses && npm run check:hygiene && npm run check:secrets",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
